    "next": "^16.4.6",
    "postgres": "^3.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",

# Copy to .env.local. Never commit real values. Validated by zod in lib/platform/env.ts.

# --- Supabase (browser sees only URL + anon key) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only

# --- Database (server-only) ---
# App: transaction-mode pooler URL. Local: supabase start -> port 54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# drizzle-kit migrations: direct (non-pooled) connection.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- App ---
APP_URL=http://localhost:3000
# Shared secrets for app/api/cron/* (Authorization: Bearer) and app/api/tasks/* (x-task-secret). >= 16 chars.
CRON_SECRET=
TASKS_SECRET=

# --- Application-layer encryption (PAN, bank account numbers) ---
# "id:base64(32 bytes)" pairs, comma separated; the active id encrypts, all ids decrypt (rotation).
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=k1

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Music Rights Marketplace <no-reply@example.com>
OPS_ALERT_EMAIL=

# Added by later milestones as they are used: Razorpay (M4), MSG91 (M1), ACRCloud (M2),
# YouTube Data API (M6), R2 backup bucket (M11), [CA]/[Lawyer] config values (M3-M5).

# --- Razorpay (test-mode keys everywhere except production) ---
# Webhook secret is set on the Razorpay dashboard webhook pointing at /api/webhooks/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- [CA] billing config: confirm values with the CA before launch (PLAN 8.2/8.3) ---
SUPPLIER_GSTIN=                 # platform GSTIN; its first two digits are the supplier state
SUPPLIER_LEGAL_NAME=            # as registered for GST; printed on every invoice
SUPPLIER_ADDRESS=               # registered place of business, one line
SAC_CODE=                       # under heading 9973 (licensing of IP); exact code [CA]
GST_RATE_BPS=1800
DEFAULT_ROYALTY_RATE_BPS=       # seller royalty when the seller profile has no contract rate [CA]/contract
# Payouts (PLAN 8.3, F5) [CA]: TDS on royalties, reverse-charge GST for unregistered sellers, run day.
TDS_RATE_BPS=
TDS_RATE_NO_PAN_BPS=            # higher rate when the seller has no PAN on file
TDS_FY_THRESHOLD_PAISE=         # TDS applies once a seller's payouts in the financial year exceed this
RCM_ON_UNREGISTERED_SELLERS=    # true|false: platform pays GST under reverse charge for unregistered sellers
PAYOUT_MIN_PAISE=               # balances below this carry forward
PAYOUT_DAY_OF_MONTH=5           # the payouts cron computes the previous month's batch on this day

# --- Clearance and disputes (PLAN 4.5/4.6) ---
CLEARANCE_TURNAROUND_BUSINESS_DAYS=1   # seller contract turnaround; default 1
CLAIM_RELEASE_REFUND_WINDOW_DAYS=7     # [Lawyer] days from dispute open until a refund-eligible claim qualifies; default 7
YOUTUBE_API_KEY=                       # bio-code check of YouTube channel descriptions; unset = admin confirms channels by hand

# --- Phone OTP via MSG91 (Supabase "Send SMS" auth hook -> /api/auth/sms-hook) ---
# Hook secret as shown in Supabase Dashboard > Auth > Hooks ("v1,whsec_..."). MSG91 needs a DLT-registered OTP template.
SEND_SMS_HOOK_SECRET=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# --- Audio fingerprint screening (ACRCloud). Optional: without it screening reports "unavailable" and the admin claim probe is the only check ---
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# --- Off-site Storage backup (Cloudflare R2, PLAN F11). The storage-backup cron fails and alerts ops until all four are set ---
BACKUP_S3_ENDPOINT=                    # https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- e2e (Playwright, tests only; not read by the app) ---
# DATABASE_URL must be a local database (the signed-in specs insert a throwaway admin user and read real rows).
# E2E_BASE_URL=http://localhost:3000   # the running dev server
# E2E_CHANNEL=chrome                   # drive an installed Chrome instead of Playwright's own download
# RAZORPAY_API_URL=http://127.0.0.1:54399/v1   # tests only: points the Razorpay adapter at the e2e stand-in. Must name this machine; anything else is refused.
# RAZORPAY_KEY_SECRET must be the same value for the dev server and for the Playwright run (the golden-path spec signs with it).
# The dev server's NEXT_PUBLIC_SUPABASE_URL must be the default local one: the specs run a fake Auth server on its port.

# Copy to .env.local. Never commit real values. Validated by zod in lib/platform/env.ts.

# --- Supabase (browser sees only URL + anon key) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only

# --- Database (server-only) ---
# App: transaction-mode pooler URL. Local: supabase start -> port 54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# drizzle-kit migrations: direct (non-pooled) connection.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- App ---
APP_URL=http://localhost:3000
# Shared secrets for app/api/cron/* (Authorization: Bearer) and app/api/tasks/* (x-task-secret). >= 16 chars.
CRON_SECRET=
TASKS_SECRET=

# --- Application-layer encryption (PAN, bank account numbers) ---
# "id:base64(32 bytes)" pairs, comma separated; the active id encrypts, all ids decrypt (rotation).
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=k1

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Music Rights Marketplace <no-reply@example.com>
OPS_ALERT_EMAIL=

# Added by later milestones as they are used: Razorpay (M4), MSG91 (M1), ACRCloud (M2),
# YouTube Data API (M6), R2 backup bucket (M11), [CA]/[Lawyer] config values (M3-M5).

# --- Phone OTP via MSG91 (Supabase "Send SMS" auth hook -> /api/auth/sms-hook) ---
# Hook secret as shown in Supabase Dashboard > Auth > Hooks ("v1,whsec_..."). MSG91 needs a DLT-registered OTP template.
SEND_SMS_HOOK_SECRET=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# --- Audio fingerprint screening (ACRCloud). Optional: without it screening reports "unavailable" and the admin claim probe is the only check ---
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
